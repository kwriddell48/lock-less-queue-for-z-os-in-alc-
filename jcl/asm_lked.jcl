//MPMCQ    JOB (ACCT),'MPMCQ',CLASS=A,MSGCLASS=X,NOTIFY=&SYSUID
//*-------------------------------------------------------------------*
//* Sample JCL to assemble & link-edit the MPMCQ modules.
//* Adjust dataset names, SYS1.MACLIB concatenations, and output libs.
//*-------------------------------------------------------------------*
//ASM      EXEC PGM=ASMA90,PARM='OBJECT,NOESD'
//SYSLIB   DD  DISP=SHR,DSN=SYS1.MACLIB
//         DD  DISP=SHR,DSN=SYS1.MODGEN
//SYSIN    DD  DISP=SHR,DSN=YOUR.SOURCE.PDS(MPMCQ)         <== QINIT/QENQ/QDEQ
//SYSPRINT DD  SYSOUT=*
//SYSLIN   DD  DSN=&&OBJ,DISP=(MOD,PASS),UNIT=SYSDA,SPACE=(TRK,(10,10))
//SYSUT1   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//SYSUT2   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//SYSUT3   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//SYSUT4   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//SYSUT5   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//SYSUT6   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//SYSUT7   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//SYSUT8   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//SYSUT9   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//ASMFL    EXEC PGM=ASMA90,PARM='OBJECT,NOESD'
//SYSLIB   DD  DISP=SHR,DSN=SYS1.MACLIB
//         DD  DISP=SHR,DSN=SYS1.MODGEN
//SYSIN    DD  DISP=SHR,DSN=YOUR.SOURCE.PDS(MPMCQFL)       <== freelist
//SYSPRINT DD  SYSOUT=*
//SYSLIN   DD  DSN=&&OBJ,DISP=(MOD,PASS),UNIT=SYSDA,SPACE=(TRK,(10,10))
//SYSUT1   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//SYSUT2   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//SYSUT3   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//SYSUT4   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//SYSUT5   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//SYSUT6   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//SYSUT7   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//SYSUT8   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//SYSUT9   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//ASMSTO   EXEC PGM=ASMA90,PARM='OBJECT,NOESD'
//SYSLIB   DD  DISP=SHR,DSN=SYS1.MACLIB
//         DD  DISP=SHR,DSN=SYS1.MODGEN
//SYSIN    DD  DISP=SHR,DSN=YOUR.SOURCE.PDS(MPMCQSTO)      <== IARV64 wrappers
//SYSPRINT DD  SYSOUT=*
//SYSLIN   DD  DSN=&&OBJ,DISP=(MOD,PASS),UNIT=SYSDA,SPACE=(TRK,(10,10))
//SYSUT1   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//SYSUT2   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//SYSUT3   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//SYSUT4   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//SYSUT5   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//SYSUT6   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//SYSUT7   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//SYSUT8   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//SYSUT9   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//ASMNT    EXEC PGM=ASMA90,PARM='OBJECT,NOESD'
//SYSLIB   DD  DISP=SHR,DSN=SYS1.MACLIB
//         DD  DISP=SHR,DSN=SYS1.MODGEN
//SYSIN    DD  DISP=SHR,DSN=YOUR.SOURCE.PDS(MPMCQNT)       <== notifier TCB
//SYSPRINT DD  SYSOUT=*
//SYSLIN   DD  DSN=&&OBJ,DISP=(MOD,PASS),UNIT=SYSDA,SPACE=(TRK,(10,10))
//SYSUT1   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//SYSUT2   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//SYSUT3   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//SYSUT4   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//SYSUT5   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//SYSUT6   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//SYSUT7   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//SYSUT8   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//SYSUT9   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//ASMST    EXEC PGM=ASMA90,PARM='OBJECT,NOESD'
//SYSLIB   DD  DISP=SHR,DSN=SYS1.MACLIB
//         DD  DISP=SHR,DSN=SYS1.MODGEN
//SYSIN    DD  DISP=SHR,DSN=YOUR.SOURCE.PDS(MPMCQST)       <== QSTATS
//SYSPRINT DD  SYSOUT=*
//SYSLIN   DD  DSN=&&OBJ,DISP=(MOD,PASS),UNIT=SYSDA,SPACE=(TRK,(10,10))
//ASMVER   EXEC PGM=ASMA90,PARM='OBJECT,NOESD'
//SYSLIB   DD  DISP=SHR,DSN=SYS1.MACLIB
//         DD  DISP=SHR,DSN=SYS1.MODGEN
//SYSIN    DD  DISP=SHR,DSN=YOUR.SOURCE.PDS(MPMCQVER)      <== GETVERSION
//SYSPRINT DD  SYSOUT=*
//SYSLIN   DD  DSN=&&OBJ,DISP=(MOD,PASS),UNIT=SYSDA,SPACE=(TRK,(10,10))
//SYSUT1   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//SYSUT2   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//SYSUT3   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//SYSUT4   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//SYSUT5   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//SYSUT6   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//SYSUT7   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//SYSUT8   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//SYSUT9   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//LKED     EXEC PGM=HEWL,PARM='XREF,LIST,RENT,LET,MAP'
//SYSLIN   DD  DSN=&&OBJ,DISP=(OLD,DELETE)
//SYSLMOD  DD  DISP=SHR,DSN=YOUR.LOADLIB
//SYSPRINT DD  SYSOUT=*
//SYSUT1   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//SYSIN    DD  *
  ENTRY   QINIT
  NAME    MPMCQ(R)
/*

