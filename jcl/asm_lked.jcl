//MPMCQ   JOB (ACCT),'MPMCQ',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID,LINES=999999,TIME=1
//*
//* HLQ IS Z72675. THESE DATA SETS MUST ALREADY EXIST:
//*   Z72675.QUEUE.ASM   ASSEMBLER SOURCE
//*   Z72675.QUEUE.MAC   MACROS AND COPY MEMBERS
//*   Z72675.QUEUE.OBJ   OBJECT MEMBERS
//*   Z72675.QUEUE.LOAD  LOAD MODULE MPMCQ
//*
//* ZOWE/upload-src.ps1 PUTS .ASM IN QUEUE.ASM AND
//* .MAC/.INC IN QUEUE.MAC. MEMBERS ARE 1-8 CHARS:
//*   MPMCQ, MPMCQFL, MPMCQSTO, MPMCQNT, MPMCQST,
//*   REGS, DSECTS, API, ATOMICS, COPY64, LINKAGE.
//* NOLIST AVOIDS S722 ON A FULL LISTING OF MPMCQ.
//* THE BIND STEP NAMES THE MODULE WITH SYSLMOD AND OMITS NAME.
//*
//         SET HLQ=Z72675
//*
//ASM      EXEC PGM=ASMA90,
//             PARM='OBJECT,NODECK,RENT,GOFF,MACHINE(Z15),LIST(133)'
//SYSLIB   DD  DISP=SHR,DSN=&HLQ..QUEUE.MAC
//         DD  DISP=SHR,DSN=SYS1.MACLIB
//         DD  DISP=SHR,DSN=SYS1.MODGEN
//SYSIN    DD  DISP=SHR,DSN=&HLQ..QUEUE.ASM(MPMCQ)
//SYSPRINT DD  SYSOUT=*
//SYSLIN   DD  DISP=SHR,DSN=&HLQ..QUEUE.OBJ(MPMCQ)
//SYSUT1   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//SYSUT2   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//SYSUT3   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//*
//ASMFL    EXEC PGM=ASMA90,
//             PARM='OBJECT,NODECK,RENT,GOFF,MACHINE(Z15),LIST(133)'
//SYSLIB   DD  DISP=SHR,DSN=&HLQ..QUEUE.MAC
//         DD  DISP=SHR,DSN=SYS1.MACLIB
//         DD  DISP=SHR,DSN=SYS1.MODGEN
//SYSIN    DD  DISP=SHR,DSN=&HLQ..QUEUE.ASM(MPMCQFL)
//SYSPRINT DD  SYSOUT=*
//SYSLIN   DD  DISP=SHR,DSN=&HLQ..QUEUE.OBJ(MPMCQFL)
//SYSUT1   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//SYSUT2   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//SYSUT3   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//*
//ASMSTO   EXEC PGM=ASMA90,
//             PARM='OBJECT,NODECK,RENT,GOFF,MACHINE(Z15),LIST(133)'
//SYSLIB   DD  DISP=SHR,DSN=&HLQ..QUEUE.MAC
//         DD  DISP=SHR,DSN=SYS1.MACLIB
//         DD  DISP=SHR,DSN=SYS1.MODGEN
//SYSIN    DD  DISP=SHR,DSN=&HLQ..QUEUE.ASM(MPMCQSTO)
//SYSPRINT DD  SYSOUT=*
//SYSLIN   DD  DISP=SHR,DSN=&HLQ..QUEUE.OBJ(MPMCQSTO)
//SYSUT1   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//SYSUT2   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//SYSUT3   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//*
//ASMNT    EXEC PGM=ASMA90,
//             PARM='OBJECT,NODECK,RENT,GOFF,MACHINE(Z15),LIST(133)'
//SYSLIB   DD  DISP=SHR,DSN=&HLQ..QUEUE.MAC
//         DD  DISP=SHR,DSN=SYS1.MACLIB
//         DD  DISP=SHR,DSN=SYS1.MODGEN
//SYSIN    DD  DISP=SHR,DSN=&HLQ..QUEUE.ASM(MPMCQNT)
//SYSPRINT DD  SYSOUT=*
//SYSLIN   DD  DISP=SHR,DSN=&HLQ..QUEUE.OBJ(MPMCQNT)
//SYSUT1   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//SYSUT2   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//SYSUT3   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//*
//ASMST    EXEC PGM=ASMA90,
//             PARM='OBJECT,NODECK,RENT,GOFF,MACHINE(Z15),LIST(133)'
//SYSLIB   DD  DISP=SHR,DSN=&HLQ..QUEUE.MAC
//         DD  DISP=SHR,DSN=SYS1.MACLIB
//         DD  DISP=SHR,DSN=SYS1.MODGEN
//SYSIN    DD  DISP=SHR,DSN=&HLQ..QUEUE.ASM(MPMCQST)
//SYSPRINT DD  SYSOUT=*
//SYSLIN   DD  DISP=SHR,DSN=&HLQ..QUEUE.OBJ(MPMCQST)
//SYSUT1   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//SYSUT2   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//SYSUT3   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//*
//LKED     EXEC PGM=IEWL,
//             PARM='RENT,AMODE(31),RMODE(ANY),MAP,LIST,XREF'
//SYSLIB   DD  DISP=SHR,DSN=&HLQ..QUEUE.OBJ
//SYSLMOD  DD  DISP=SHR,DSN=&HLQ..QUEUE.LOAD(MPMCQ)
//SYSPRINT DD  SYSOUT=*
//SYSUT1   DD  UNIT=SYSDA,SPACE=(TRK,(10,10))
//SYSLIN   DD  *
  INCLUDE SYSLIB(MPMCQ)
  INCLUDE SYSLIB(MPMCQFL)
  INCLUDE SYSLIB(MPMCQSTO)
  INCLUDE SYSLIB(MPMCQNT)
  INCLUDE SYSLIB(MPMCQST)
  ENTRY   QINIT
/*
