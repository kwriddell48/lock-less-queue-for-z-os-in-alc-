//MPMCQT  JOB (ACCT),'MPMCQ TEST',CLASS=A,
//             MSGCLASS=X,NOTIFY=&SYSUID,
//             LINES=999999,TIME=30,REGION=0M,
//             MEMLIMIT=2G
//*
//* UPLOAD WITH ZOWE/upload-test.ps1 BEFORE SUBMIT.
//*   QSTUB -> Z72675.QUEUE.ASM(QSTUB)
//*   .C -> QUEUE.C    .H -> QUEUE.H (FB 80)
//* QUEUE.OBJ AND QUEUE.LOAD MUST ALREADY EXIST.
//* OBJECTS: MPMCQ MPMCQFL MPMCQSTO MPMCQNT MPMCQST
//*
//         SET HLQ=Z72675
//*
//ASM      EXEC PGM=ASMA90,
//             PARM='OBJECT,NODECK,RENT,GOFF,MACHINE(Z15),NOLIST'
//SYSLIB   DD DISP=SHR,DSN=SYS1.MACLIB
//         DD DISP=SHR,DSN=&HLQ..QUEUE.MAC
//SYSIN    DD DISP=SHR,DSN=&HLQ..QUEUE.ASM(QSTUB)
//SYSPRINT DD SYSOUT=*
//SYSLIN   DD DISP=SHR,DSN=&HLQ..QUEUE.OBJ(QSTUB)
//SYSUT1   DD UNIT=SYSDA,SPACE=(TRK,(5,5))
//SYSUT2   DD UNIT=SYSDA,SPACE=(TRK,(5,5))
//SYSUT3   DD UNIT=SYSDA,SPACE=(TRK,(5,5))
//*
//CCALL    EXEC PGM=CCNDRVR,PARM='OPTFILE(DD:COPTS)'
//COPTS    DD *
NOXPLINK
ILP32
NOSEQUENCE
NOOPTIMIZE
ARCH(13)
RENT
NOLONGNAME
NOSOURCE
OBJECT
/*
//SYSLIB   DD DISP=SHR,DSN=CEE.SCEEH.H
//         DD DISP=SHR,DSN=CEE.SCEEH.SYS.H
//         DD DISP=SHR,DSN=&HLQ..QUEUE.H
//SYSIN    DD DISP=SHR,DSN=&HLQ..QUEUE.C(QCALL)
//SYSLIN   DD DISP=SHR,DSN=&HLQ..QUEUE.OBJ(QCALL)
//SYSPRINT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSCPRT  DD SYSOUT=*
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT4   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT5   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT6   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT7   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT8   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT9   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT10  DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT14  DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//*
//GOTEST   PROC MEM=,PARMS='/'
//CC       EXEC PGM=CCNDRVR,PARM='OPTFILE(DD:COPTS)'
//COPTS    DD *
NOXPLINK
ILP32
NOSEQUENCE
NOOPTIMIZE
ARCH(13)
RENT
NOLONGNAME
NOSOURCE
OBJECT
/*
//SYSLIB   DD DISP=SHR,DSN=CEE.SCEEH.H
//         DD DISP=SHR,DSN=CEE.SCEEH.SYS.H
//         DD DISP=SHR,DSN=&HLQ..QUEUE.H
//SYSIN    DD DISP=SHR,DSN=&HLQ..QUEUE.C(&MEM)
//SYSLIN   DD DSN=&&OBJ,DISP=(NEW,PASS),
//             UNIT=SYSDA,SPACE=(TRK,(20,20)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=3200)
//SYSPRINT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSCPRT  DD SYSOUT=*
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT4   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT5   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT6   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT7   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT8   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT9   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT10  DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT14  DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//IFCC     IF (CC.RC LE 4) THEN
//BD       EXEC PGM=IEWL,
//             PARM='RENT,AMODE(31),RMODE(ANY),MAP,XREF'
//SYSLIB   DD DISP=SHR,DSN=CEE.SCEELKED
//         DD DISP=SHR,DSN=SYS1.CSSLIB
//         DD DISP=SHR,DSN=&HLQ..QUEUE.OBJ
//SYSLMOD  DD DISP=SHR,
//             DSN=&HLQ..QUEUE.LOAD(&MEM)
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD UNIT=SYSDA,SPACE=(TRK,(20,20))
//SYSLIN   DD DSN=&&OBJ,DISP=(OLD,DELETE)
//         DD *
 INCLUDE SYSLIB(QCALL)
 INCLUDE SYSLIB(QSTUB)
 INCLUDE SYSLIB(MPMCQ)
 INCLUDE SYSLIB(MPMCQFL)
 INCLUDE SYSLIB(MPMCQSTO)
 INCLUDE SYSLIB(MPMCQNT)
 INCLUDE SYSLIB(MPMCQST)
 ENTRY CEESTART
/*
//IFBD     IF (BD.RC LE 4) THEN
//GO       EXEC PGM=&MEM,PARM='&PARMS'
//STEPLIB  DD DISP=SHR,DSN=&HLQ..QUEUE.LOAD
//SYSPRINT DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
//EIFBD    ENDIF
//EIFCC    ENDIF
//         PEND
//*
//IFGO     IF ((ASM.RC LE 4) & (CCALL.RC LE 4)) THEN
//S01      EXEC GOTEST,MEM=T01INIT
//S02      EXEC GOTEST,MEM=T02FIFO
//S03      EXEC GOTEST,MEM=T03TRUNC
//S04      EXEC GOTEST,MEM=T04LENS
//S05      EXEC GOTEST,MEM=T05STAT
//S06      EXEC GOTEST,MEM=T06ECB
//S07      EXEC GOTEST,MEM=T07CB
//S08      EXEC GOTEST,MEM=T08PAIR,
//             PARMS='POSIX(ON)/'
//S09      EXEC GOTEST,MEM=T09MPMC,
//             PARMS='POSIX(ON)/'
//S10      EXEC GOTEST,MEM=T10MP25,
//             PARMS='POSIX(ON)/'
//S11      EXEC GOTEST,MEM=T11LARGE,
//             PARMS='POSIX(ON)/'
//S12      EXEC GOTEST,MEM=T12WAVE,
//             PARMS='POSIX(ON)/'
//S13      EXEC GOTEST,MEM=T13ASYM,
//             PARMS='POSIX(ON)/'
//S14      EXEC GOTEST,MEM=T14STOP
//S15      EXEC GOTEST,MEM=T15BOTH
//S16      EXEC GOTEST,MEM=T16STAT,
//             PARMS='POSIX(ON)/'
//S17      EXEC GOTEST,MEM=T17NOPOL
//S18      EXEC GOTEST,MEM=T18MULTI,
//             PARMS='POSIX(ON)/'
//S19      EXEC GOTEST,MEM=T19CHURN,
//             PARMS='POSIX(ON)/'
//S20      EXEC GOTEST,MEM=T20LRGMP,
//             PARMS='POSIX(ON)/'
//S21      EXEC GOTEST,MEM=T21COLD,
//             PARMS='POSIX(ON)/'
//S22      EXEC GOTEST,MEM=T22BOUND
//S23      EXEC GOTEST,MEM=T23NTFST,
//             PARMS='POSIX(ON)/'
//S25      EXEC GOTEST,MEM=T25BENCH,
//             PARMS='POSIX(ON)/'
//S24A     EXEC PGM=ASMA90,
//  PARM='OBJECT,NODECK,RENT,GOFF,MACHINE(Z15),NOLIST'
//SYSLIB   DD DISP=SHR,DSN=&HLQ..QUEUE.MAC
//         DD DISP=SHR,DSN=SYS1.MACLIB
//SYSIN    DD DISP=SHR,DSN=&HLQ..QUEUE.ASM(T24HGPR)
//SYSLIN   DD DISP=SHR,DSN=&HLQ..QUEUE.OBJ(T24HGPR)
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD UNIT=SYSDA,SPACE=(TRK,(5,5))
//SYSUT2   DD UNIT=SYSDA,SPACE=(TRK,(5,5))
//SYSUT3   DD UNIT=SYSDA,SPACE=(TRK,(5,5))
//IF24     IF (S24A.RC LE 4) THEN
//S24B     EXEC PGM=IEWL,
//  PARM='RENT,AMODE(31),RMODE(ANY)'
//SYSLIB   DD DISP=SHR,DSN=&HLQ..QUEUE.OBJ
//SYSLMOD  DD DISP=SHR,DSN=&HLQ..QUEUE.LOAD(T24HGPR)
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD UNIT=SYSDA,SPACE=(TRK,(20,20))
//SYSLIN   DD *
 INCLUDE SYSLIB(T24HGPR)
 INCLUDE SYSLIB(MPMCQ)
 INCLUDE SYSLIB(MPMCQFL)
 INCLUDE SYSLIB(MPMCQSTO)
 INCLUDE SYSLIB(MPMCQNT)
 INCLUDE SYSLIB(MPMCQST)
 ENTRY T24HGPR
/*
//IF24B    IF (S24B.RC LE 4) THEN
//S24      EXEC PGM=T24HGPR
//STEPLIB  DD DISP=SHR,DSN=&HLQ..QUEUE.LOAD
//SYSPRINT DD SYSOUT=*
//EIF24B   ENDIF
//EIF24    ENDIF
//EIFGO    ENDIF
