         TITLE 'API - CALLING CONVENTION'
***********************************************************************
*  API.INC
*  COPY DSECTS FIRST. QCB_SIZE_PUB MUST EQUAL QCB_SIZE.
*  PAY31_MAX IS THE 31-BIT SLAB CAP (POOL_64K). ABOVE IT: IARV64.
*  PAY64_MAX IS ONE MVCL (24-BIT LENGTH).
*  RC_ALIGN (12) MEANS THE QCB IS NOT 256-BYTE ALIGNED.
***********************************************************************
PAY31_MAX EQU   65536
PAY64_MAX EQU   X'00FFFFFF'
QCB_ALIGN EQU   256
RC_OK     EQU   0
RC_EMPTY  EQU   4
RC_ALLOC  EQU   8
RC_TRUNC  EQU   8
RC_ALIGN  EQU   12
QCB_SIZE_PUB EQU 1336
         AIF   (PAY31_MAX EQ POOL_64K).APIP31
         MNOTE 8,'PAY31_MAX MUST EQUAL POOL_64K'
.APIP31  ANOP
QCBF_STOP EQU   X'80000000'
         AIF   (QCB_SIZE EQ QCB_SIZE_PUB).APIQOK
         MNOTE 8,'QCB_SIZE CHANGED; UPDATE DSECTS.INC AND API.INC'
.APIQOK  ANOP
